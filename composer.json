{
    "name": "stougeiro/pdo-contract",
    "description": "PDO-based database contract: interfaces and enums for a dialect-agnostic model, a single-method IR-driven driver and a normalized raw/result layer, covering SQLite, MySQL and PostgreSQL.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "pdo",
        "database",
        "contract",
        "interface",
        "query-tree",
        "ir",
        "sql",
        "sqlite",
        "mysql",
        "postgresql",
        "driver",
        "model"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/pdo-contract/issues",
        "source": "https://github.com/stougeiro/pdo-contract"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Contract\\Pdo\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "stan": "vendor/bin/phpstan"
    }
}
